# =============================================================================
# Environment template — copy to `.env` (never commit `.env`)
#
# POLICY: docs/adr/ADR-002-env-separation.md
#
# WARNING — Expo client bundle:
#   Any variable named EXPO_PUBLIC_* is embedded in the JavaScript bundle.
#   Treat EXPO_PUBLIC_* as visible to anyone who inspects the app. API keys
#   in EXPO_PUBLIC_* are OK for local dev / throwaway keys only — NOT for
#   production-grade secrecy. Server-only secrets should live on a backend.
# =============================================================================

# ── LLM (Gemini cloud or Ollama local) ───────────────────────────────────────

# [CLIENT-SAFE] Provider: gemini | ollama
EXPO_PUBLIC_LLM_PROVIDER=gemini

# [SERVER-ONLY — currently via EXPO_PUBLIC_: exposed in client bundle]
# Dev-only until a backend proxy holds this key. Do not rely on this for prod.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: switch LLM to local Ollama (Gemma 3)
# [CLIENT-SAFE] Provider toggle (uncomment together with Ollama vars)
# EXPO_PUBLIC_LLM_PROVIDER=ollama
# [CLIENT-SAFE — operational] Use your machine LAN IP on a physical device, not localhost.
# EXPO_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# [CLIENT-SAFE] Model id
# EXPO_PUBLIC_OLLAMA_MODEL=gemma3

# ── Transcription (Whisper local server or OpenAI Whisper API) ───────────────

# [CLIENT-SAFE] Provider: local | openai
EXPO_PUBLIC_WHISPER_PROVIDER=local

# [CLIENT-SAFE — operational] Local whisper server; use LAN IP on device, not localhost.
EXPO_PUBLIC_WHISPER_LOCAL_URL=http://localhost:9000

# [CLIENT-SAFE] Whisper model name (local stack)
EXPO_PUBLIC_WHISPER_MODEL=base

# Optional: switch transcription to OpenAI Whisper API
# [CLIENT-SAFE] Provider toggle
# EXPO_PUBLIC_WHISPER_PROVIDER=openai
# [SERVER-ONLY — currently via EXPO_PUBLIC_: exposed in client bundle]
# Dev-only until a backend proxy holds this key.
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
