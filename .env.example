# =============================================================================
# Mobile app (.env) — copy to `.env` at repo root (never commit `.env`)
#
# POLICY: docs/adr/ADR-002-env-separation.md
#
# Preferred: only client-safe values below (public backend URL + feature flags).
# Provider API keys for production belong in `backend/.env`, not here.
#
# WARNING — EXPO_PUBLIC_* is embedded in the JS bundle. Treat as world-readable.
# =============================================================================

# ── Preferred (client-safe) ──────────────────────────────────────────────────

# HTTP origin of the Node backend (no trailing slash). Use LAN IP from a device.
EXPO_PUBLIC_BACKEND_API_BASE=http://127.0.0.1:8787

# 1 = try Node backend first for summarise/transcribe, then legacy providers; 0 = legacy only
EXPO_PUBLIC_USE_BACKEND_PIPELINE=0

# Deprecated: same effect as EXPO_PUBLIC_USE_BACKEND_PIPELINE if the latter is unset
# EXPO_PUBLIC_FEATURE_BACKEND_AI=0

# ── Legacy (optional) — direct client-side LLM / Whisper ───────────────────────
# Still supported for local dev. Do not put production secrets here.

# EXPO_PUBLIC_LLM_PROVIDER=gemini
# EXPO_PUBLIC_GEMINI_API_KEY=

# EXPO_PUBLIC_LLM_PROVIDER=ollama
# EXPO_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# EXPO_PUBLIC_OLLAMA_MODEL=gemma3:4b

# EXPO_PUBLIC_WHISPER_PROVIDER=local
# EXPO_PUBLIC_WHISPER_LOCAL_URL=http://localhost:9000
# EXPO_PUBLIC_WHISPER_MODEL=base

# EXPO_PUBLIC_WHISPER_PROVIDER=openai
# EXPO_PUBLIC_OPENAI_API_KEY=
