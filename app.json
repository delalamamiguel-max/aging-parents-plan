{
  "expo": {
    "name": "Aging Parents Plan",
    "slug": "aging-parents-plan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agingparentsplan.mvp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aging Parents Plan uses your microphone to capture your voice description of a doctor visit.",
        "NSCalendarsUsageDescription": "Aging Parents Plan uses your calendar to add follow-up appointments you confirm.",
        "NSPhotoLibraryUsageDescription": "Aging Parents Plan uses your photo library to capture discharge paperwork or notes."
      }
    },
    "android": {
      "package": "com.agingparentsplan.mvp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F5D50"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-av",
      "expo-image-picker",
      "expo-notifications",
      "expo-calendar",
      "expo-localization"
    ]
  }
}
