# Aging Parents Plan — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM Provider (Gemma 3 via local Ollama) ──────────────────────────────────
EXPO_PUBLIC_LLM_PROVIDER=ollama
EXPO_PUBLIC_OLLAMA_BASE_URL=http://192.168.1.73:11434
EXPO_PUBLIC_OLLAMA_MODEL=gemma3:4b

# Optional: switch to Gemini cloud instead
# EXPO_PUBLIC_LLM_PROVIDER=gemini
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key_here

# ── Transcription (local Whisper server) ──────────────────────────────────────
EXPO_PUBLIC_WHISPER_PROVIDER=local
EXPO_PUBLIC_WHISPER_LOCAL_URL=http://192.168.1.73:9000
EXPO_PUBLIC_WHISPER_MODEL=base

# Optional: switch to OpenAI Whisper API instead
# EXPO_PUBLIC_WHISPER_PROVIDER=openai
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_key_here
