EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_LLM_PROVIDER=gemini

# Optional: switch LLM to local Ollama (Gemma 3)
# EXPO_PUBLIC_LLM_PROVIDER=ollama
# EXPO_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# EXPO_PUBLIC_OLLAMA_MODEL=gemma3

# ── Transcription ─────────────────────────────────────────────────────────────
# Local Whisper server (default for dev — run whisper_server.py first)
EXPO_PUBLIC_WHISPER_PROVIDER=local
EXPO_PUBLIC_WHISPER_LOCAL_URL=http://localhost:9000
EXPO_PUBLIC_WHISPER_MODEL=base

# Optional: switch transcription to OpenAI Whisper API
# EXPO_PUBLIC_WHISPER_PROVIDER=openai
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
