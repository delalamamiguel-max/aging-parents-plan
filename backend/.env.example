# =============================================================================
# Backend server only — copy to `backend/.env` (never commit real `.env`)
#
# These variables are NOT prefixed with EXPO_PUBLIC_. They stay on the server
# and are not bundled into the mobile app. See repo root `.env.example` for
# the Expo client template.
#
# Load: `import 'dotenv/config'` in `src/server.ts` (already wired).
# =============================================================================

# Server
BACKEND_PORT=8787

# ── LLM (two-stage pipeline) — Ollama Cloud only ────────────────────────────
#
# Policy: the server refuses to start unless OLLAMA_BASE_URL is https:// and
# OLLAMA_API_KEY is set. Local Ollama daemons and Gemini are not supported.
#
# The pipeline is sequential and uses two distinct models:
#   Stage 1 (extraction): OCR / PDF text (text + image inputs only).
#   Stage 2 (structured): context-aware extraction over Stage 1 output.
# The two model names MUST be different.
#
# Audio transcription does NOT run on Ollama — Ollama Cloud has no ASR
# endpoint. See STT section below.

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Stage 1 — OCR + PDF text extraction (no audio). Vision-capable cloud model.
OLLAMA_EXTRACTION_MODEL=gemma4:31b-cloud

# Stage 2 — context-aware document understanding + structured extraction.
# Use a NON-thinking instruct model here: thinking cloud tags (e.g.
# qwen3.5:cloud) silently burn time/tokens on internal reasoning and often
# return HTTP 200 with empty message.content when format:json is requested.
# Ministral 3 (14B, Mistral instruct) is a reliable default.
OLLAMA_STRUCTURED_MODEL=ministral-3:14b-cloud

# Outbound chat timeout in ms (default 120000, applies per summarize stage)
# OLLAMA_TIMEOUT_MS=120000


# ── Speech-to-text (POST /transcribe) ──────────────────────────────────────
#
# Ollama Cloud has no ASR endpoint, so voice recording uses a dedicated hosted
# Whisper model. The API key is held server-side only; the mobile client never
# talks to the STT provider directly (keeps ADR-002: no client secrets).

# Provider. Only "groq" is supported today.
STT_PROVIDER=groq

# Model. Groq hosts whisper-large-v3-turbo (fast + high quality, bilingual).
# Alternative: whisper-large-v3 (slightly slower, same quality).
STT_MODEL=whisper-large-v3-turbo

# End-to-end STT timeout in ms. Whisper turbo typically returns in <1s;
# 60s covers cold starts and longer clips up to a few minutes.
# STT_TIMEOUT_MS=60000

# Groq base URL (OpenAI-compatible surface lives under /openai/v1/…).
# GROQ_BASE_URL=https://api.groq.com

# Required when STT_PROVIDER=groq. Create at https://console.groq.com/keys.
# Free tier is plenty for development. Key format: gsk_...
GROQ_API_KEY=
