# =============================================================================
# Backend server only — copy to `backend/.env` (never commit real `.env`)
#
# These variables are NOT prefixed with EXPO_PUBLIC_. They stay on the server
# and are not bundled into the mobile app. See repo root `.env.example` for
# the Expo client template.
#
# Load: `import 'dotenv/config'` in `src/server.ts` (already wired).
# =============================================================================

# Server
BACKEND_PORT=8787

# ── LLM (summarisation) — choose one path ───────────────────────────────────

LLM_PROVIDER=ollama

# If LLM_PROVIDER=gemini
GEMINI_API_KEY=

# If LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# ── Transcription (Whisper) ─────────────────────────────────────────────────

WHISPER_PROVIDER=local

# If WHISPER_PROVIDER=local (whisper_server.py or similar)
WHISPER_LOCAL_URL=http://127.0.0.1:9000
WHISPER_MODEL=base

# If WHISPER_PROVIDER=openai
OPENAI_API_KEY=
